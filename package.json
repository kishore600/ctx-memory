{
  "name": "ctx-memory",
  "version": "0.1.0",
  "description": "Local-first, git-backed memory layer for AI coding agents. Capture decisions, detect staleness, generate CLAUDE.md/AGENTS.md, and serve memory over MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "memory": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.0.9",
    "prompts": "^2.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
