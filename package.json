{
  "name": "whyanchor",
  "version": "0.1.1",
  "description": "Local-first, git-backed memory layer for AI coding agents. Capture decisions, detect staleness, generate CLAUDE.md/AGENTS.md, and serve memory over MCP.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kishore600/whyanchor.git"
  },
  "homepage": "https://github.com/kishore600/whyanchor#readme",
  "bugs": {
    "url": "https://github.com/kishore600/whyanchor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "ai-agents",
    "memory",
    "context",
    "adr",
    "architecture-decision-record",
    "developer-tools",
    "cli"
  ],
  "bin": {
    "whyanchor": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.0.9",
    "prompts": "^2.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
